df = pd.read_csv('UCI_Credit_Card.csv')


target_col = 'default.payment.next.month'
print('\nTarget distribution:')
print(df[target_col].value_counts())
print('\nTarget normalized:')
print(df[target_col].value_counts(normalize=True))





sns.set(style='whitegrid')
plt.figure(figsize=(10,5))
plt.subplot(1,2,1)
sns.countplot(x='SEX', hue=target_col, data=df)
plt.title('SEX vs Default')

plt.subplot(1,2,2)
sns.countplot(x='MARRIAGE', hue=target_col, data=df)
plt.title('MARRIAGE vs Default')
plt.tight_layout()
plt.show()


plt.figure(figsize=(8,4))
sns.histplot(df['AGE'], bins=30)
plt.title('Age Distribution')
plt.show()


plt.figure(figsize=(8,5))
sns.histplot(x=target_col, y='LIMIT_BAL', data=df)
plt.title('LIMIT_BAL by Default')
plt.yscale('log')
plt.show()


# Correlation heatmap for numeric features
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
# remove ID and target
numeric_cols = [c for c in numeric_cols if c not in ['ID', target_col]]
plt.figure(figsize=(14,10))
corr = df[numeric_cols + [target_col]].corr()
plt.figure(figsize = (15, 15))
cm = sns.heatmap(corr,
               linewidths = 1,
               annot = True,
               fmt = ".2f")
plt.title("Correlation Matrix", fontsize = 20)
plt.show()


# Visualize repayment status counts
pay_cols = ['PAY_0','PAY_2','PAY_3','PAY_4','PAY_5','PAY_6']
plt.figure(figsize=(20,10))
for i, col in enumerate(pay_cols,1):
    plt.subplot(2,3,i)
    sns.countplot(x=col, data=df)
    plt.title(col)
plt.tight_layout()
plt.show()


X = df.drop("ID", axis = 1) # area_code and phone_number features are irrelevant to proceed further to train the model


y = df["ID"]


X.shape


y.shape


# Split the dataset into training and testing sets
from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size = 0.3, random_state = 150)


X_train.shape


X_test.shape


from sklearn.ensemble import RandomForestClassifier

rf = RandomForestClassifier()
rf.fit(X_train, y_train.values.ravel())


# Get feature importance scores
# The importance score shows how strongly that feature affects the model’s output.
# High score → strongly influences the prediction
# Low score → has little or no effect on prediction

rf.feature_importances_


X.columns


# Plot feature importance

feat_scores= pd.DataFrame({"Fraction of variables affected" : rf.feature_importances_},index = X.columns)
feat_scores= feat_scores.sort_values(by = "Fraction of variables affected")
feat_scores.plot(kind = "barh", figsize = (10, 5))
sns.despine()


from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, confusion_matrix

model_LR = LogisticRegression()

model_LR.fit(X_train, y_train)


y_predict = model_LR.predict(X_test)


y_predict



